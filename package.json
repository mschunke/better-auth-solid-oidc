{
  "name": "better-auth-solid-oidc",
  "version": "0.1.0",
  "description": "Better Auth plugin for authenticating against a Solid Protocol Server, with WebID identity and DPoP-bound tokens.",
  "type": "module",
  "license": "MIT",
  "author": "Murilo Schünke <https://github.com/mschunke>",
  "homepage": "https://github.com/mschunke/better-auth-solid-oidc#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mschunke/better-auth-solid-oidc.git"
  },
  "bugs": {
    "url": "https://github.com/mschunke/better-auth-solid-oidc/issues"
  },
  "keywords": [
    "better-auth",
    "better-auth-plugin",
    "solid",
    "solid-protocol",
    "solid-oidc",
    "webid",
    "dpop",
    "oidc",
    "oauth2",
    "authentication"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "default": "./dist/client.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "jose": "^6.2.3"
  },
  "peerDependencies": {
    "@better-auth/core": "^1.7.0",
    "@better-fetch/fetch": "^1.3.1",
    "better-auth": "^1.7.0"
  },
  "devDependencies": {
    "@better-auth/core": "^1.7.2",
    "@better-fetch/fetch": "^1.3.1",
    "@biomejs/biome": "^2.5.0",
    "@types/node": "^24.13.3",
    "better-auth": "^1.7.2",
    "oauth2-mock-server": "^9.0.0",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.1.1"
}
